# Copy to .env.local and fill in. Both values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Prefer the sb_publishable_... key (Settings > API Keys). The legacy anon JWT also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Used to build OAuth redirect URLs. On Vercel Production set this to https://chorehall.net
# Never leave it blank — an empty value breaks the build and can 500 the site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — one nest subscription covers every parent and kid on that account.
# Dashboard: https://dashboard.stripe.com/apikeys  and  Products → add a recurring Price.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Needed so Stripe webhooks can write subscription status (Settings → API → service_role).
SUPABASE_SERVICE_ROLE_KEY=
