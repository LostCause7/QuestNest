# Copy to .env.local and fill in. Both values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Prefer the sb_publishable_... key (Settings > API Keys). The legacy anon JWT also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Used to build OAuth redirect URLs. Set to your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
